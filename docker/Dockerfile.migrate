# Minimal image for running Prisma database migrations.
# This is separate from the main app image because the production build
# strips devDependencies (including the Prisma CLI).

FROM node:22-bookworm-slim

ARG DEBIAN_FRONTEND="noninteractive"
WORKDIR /app

RUN apt-get update && \
    apt-get install -y openssl && \
    rm -rf /var/lib/apt/lists/*

# Copy only the prisma directory (schema + migrations)
COPY packages/database/prisma ./prisma

# Bootstrap a clean npm project and install only the Prisma CLI.
# We do NOT copy packages/database/package.json because it has workspace:*
# dependencies that npm cannot resolve outside the monorepo.
RUN npm init -y && npm install --save-dev prisma@6

CMD ["npx", "prisma", "migrate", "deploy", "--schema=./prisma/schema.prisma"]
