############################################################
# Supabase Infrastructure — Environment Variables
#
# Copy this file to .env.supabase and fill in all required
# values before running `docker compose up`.
############################################################


############################################################
# SECRETS — CHANGE ALL OF THESE BEFORE FIRST LAUNCH
############################################################

# PostgreSQL password
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# JWT secret (min 32 characters)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Legacy API keys (HS256-signed JWTs matching JWT_SECRET above).
# Use the default demo keys below for local dev, or generate new ones
# via: sh docker/utils/generate-keys.sh (from the supabase/supabase repo)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Asymmetric key pair (ES256) — optional, leave empty for legacy HS256 only
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

# Supabase Studio dashboard credentials
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-dashboard-password

# Used by postgres-meta / Studio
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# S3 protocol credentials for Supabase Storage
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907


############################################################
# URLs
############################################################

# The public URL of the Supabase API (Kong gateway).
# For local dev: http://localhost:8000
# For production: https://your-domain.com/api (behind a reverse proxy)
SUPABASE_PUBLIC_URL=http://localhost:8000

# External URL used by Supabase Auth for OAuth callbacks and email links.
# Must match SUPABASE_PUBLIC_URL for self-hosted setups.
API_EXTERNAL_URL=http://localhost:8000

# Auth "Site URL" — the URL of your shelf.nu webapp.
# Supabase redirects users here after email confirmation / password reset.
SITE_URL=http://localhost:3000

# Additional redirect URLs allowed by Supabase Auth (comma-separated).
ADDITIONAL_REDIRECT_URLS=http://localhost:3000


############################################################
# Database (PostgreSQL)
############################################################

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############################################################
# Supabase Auth
############################################################

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
# Set to true to skip email confirmation (useful for dev)
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# SMTP settings used by Supabase Auth for OTP / confirmation emails.
# Leave HOST and PORT empty to use the bundled Inbucket mail catcher (local dev).
# Set to a real SMTP provider for production.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Shelf


############################################################
# Supabase Storage
############################################################

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub


############################################################
# PostgREST
############################################################

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############################################################
# Supabase Studio
############################################################

STUDIO_DEFAULT_ORGANIZATION=shelf.nu
STUDIO_DEFAULT_PROJECT=shelf
OPENAI_API_KEY=


############################################################
# Kong API Gateway
############################################################

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=


