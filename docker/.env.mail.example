############################################################
# Inbucket Mail Catcher — Environment Variables
#
# Copy this file to .env.mail and adjust if needed.
#
# Inbucket is a local-only mail catcher for development.
# All outgoing emails are captured here instead of delivered.
# Replace SMTP_* vars in .env.supabase and .env.shelf with
# a real SMTP provider for production.
############################################################

# Host port for the Inbucket web UI (http://localhost:9000)
INBUCKET_WEB_PORT=9000

# Host port for the Inbucket SMTP server (internal: 2500)
# Supabase Auth and the webapp connect to mail:2500 inside Docker.
# Change this only if port 2500 is already in use on your machine.
INBUCKET_SMTP_PORT=2500
