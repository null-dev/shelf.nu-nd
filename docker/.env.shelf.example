############################################################
# shelf.nu Application — Environment Variables
#
# Copy this file to .env.shelf and fill in all required
# values before running `docker compose up`.
#
# Shared secrets (database password, JWT, API keys) live in
# .env.supabase and are automatically available to shelf
# services via the compose env_file merge.
############################################################


############################################################
# SECRETS — CHANGE BEFORE FIRST LAUNCH
############################################################

# shelf.nu session secret (any long random string)
SESSION_SECRET=your-super-secret-shelf-session-key-change-me

# Invite token secret (any long random string)
INVITE_TOKEN_SECRET=change-me-invite-secret


############################################################
# URLs
############################################################

# The public URL of the shelf.nu webapp (used for QR codes, emails, etc.)
SERVER_URL=http://localhost:3000


############################################################
# shelf.nu Application
############################################################

# Port the webapp listens on (host side)
SHELF_PORT=3000

APP_NAME=Shelf
FINGERPRINT=shelf-self-hosted

# Set to false to make premium features available to all users without Stripe
ENABLE_PREMIUM_FEATURES=false

# Set to true to prevent new user self-registration
SHELF_DISABLE_SIGNUP=false

# Disable SSO (recommended for self-hosted unless you have an SSO provider)
DISABLE_SSO=true

# Set to false to disable onboarding emails
SEND_ONBOARDING_EMAIL=false

ADMIN_EMAIL=admin@shelf.nu
SUPPORT_EMAIL=support@shelf.nu


############################################################
# Email (SMTP) — shelf.nu app notifications
#
# SMTP_HOST / SMTP_PORT / SMTP_USER are shared with Supabase
# Auth and live in .env.supabase.
# Only the password and sender address are shelf-specific.
#
# Leave empty to use the bundled Inbucket mail catcher (local dev).
############################################################

SMTP_PWD=
SMTP_FROM=Shelf <noreply@example.com>


############################################################
# MapTiler
#
# Required by the app even if map features aren't used.
# Get a free key at https://www.maptiler.com/ or leave empty
# to use a dummy value (maps won't render, but app will work).
############################################################

MAPTILER_TOKEN=
GEOCODING_USER_AGENT=shelf-self-hosted


############################################################
# FullCalendar
#
# Required for the booking calendar in production.
# Get a license at https://fullcalendar.io/
############################################################

FULL_CALENDAR_LICENSE_KEY=


############################################################
# Stripe
#
# Leave empty to disable premium features / subscription
# requirements (recommended for self-hosted).
############################################################

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_ENDPOINT_SECRET=
FREE_TRIAL_DAYS=14


############################################################
# Sentry (optional)
############################################################

SENTRY_DSN=
